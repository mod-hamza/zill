# Zill API: FastAPI + the shade/routing engine + baked Downtown Dubai data.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

WORKDIR /app
# dependencies first (cached unless pyproject changes)
COPY backend/pyproject.toml backend/pyproject.toml
COPY backend/zill/__init__.py backend/zill/__init__.py
RUN pip install -e ./backend

# config.py resolves the repo root as backend/.., so keep the repo layout
COPY backend backend
COPY data data

WORKDIR /app/backend
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4).status == 200 else 1)"
CMD ["uvicorn", "zill.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
