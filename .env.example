# Copy to .env and fill in keys. Never commit .env.
# --- LLM providers (order = priority; a provider without a key is skipped) ---
ZILL_LLM_PROVIDERS=opencode,voke
# OpenCode Go (https://opencode.ai/docs/go/)
ZILL_OPENCODE_API_KEY=
ZILL_OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
ZILL_OPENCODE_MODEL=kimi-k3
ZILL_OPENCODE_MODEL_FAST=glm-5.3-flash
# Voke (OpenAI-compatible). The legacy ZILL_LLM_BASE_URL / ZILL_LLM_API_KEY / ZILL_MODEL / ZILL_MODEL_FAST
# names still work and mean "voke".
ZILL_VOKE_API_KEY=
ZILL_VOKE_BASE_URL=https://www.vokeapi.com/v1
ZILL_VOKE_MODEL=claude-sonnet-5-5
ZILL_VOKE_MODEL_FAST=claude-haiku-5-5
# --- rest ---
ZILL_REPLAY=0
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
ZILL_DEFAULT_CITY=dubai_downtown
ZILL_TZ=Asia/Dubai
